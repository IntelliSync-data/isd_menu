<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu Setting List View (root menus only, editable sequence) -->
    <record id="view_menu_setting_list" model="ir.ui.view">
        <field name="name">ir.ui.menu.setting.list</field>
        <field name="model">ir.ui.menu</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Menu Setting" editable="bottom" default_order="sequence asc, id asc">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="web_icon" readonly="1" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Menu Setting Action -->
    <record id="action_menu_setting" model="ir.actions.act_window">
        <field name="name">Menu Setting</field>
        <field name="res_model">ir.ui.menu</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_menu_setting_list"/>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No root menus found
            </p>
        </field>
    </record>

    <!-- Menu Item (manager only) -->
    <menuitem id="menu_isd_menu_root"
              name="ISD Menu"
              web_icon="isd_menu,static/description/icon.png"
              sequence="999"/>

    <menuitem id="menu_isd_menu_setting"
              name="Menu Setting"
              parent="menu_isd_menu_root"
              action="action_menu_setting"
              groups="base.group_system"
              sequence="10"/>

</odoo>
